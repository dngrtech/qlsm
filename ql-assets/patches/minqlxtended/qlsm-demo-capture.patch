+
+const int dc_entityStateFieldCount91 = (int)(sizeof(dc_entityStateFields91) / sizeof(dc_entityStateFields91[0]));
+
+const dc_netField_t dc_playerStateFields91[] = {
+    PSF(commandTime, 32),
+    PSF(origin[0], 0),
